{
  "name": "geolibre",
  "version": "2.2.0",
  "private": true,
  "description": "WattByte Nexus: a free and open-source, lightweight, cloud-native GIS platform for visualizing, exploring, and analyzing geospatial data. It runs in the web browser, on the desktop, on mobile, and inside Jupyter notebooks, all while keeping your data local and private",
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "postinstall": "node scripts/patch-maplibre-time-slider.mjs",
    "dev": "npm run dev -w geolibre-desktop",
    "build": "npm run build -w geolibre-desktop",
    "storybook": "npm run storybook -w geolibre-desktop",
    "build:storybook": "npm run build-storybook -w geolibre-desktop",
    "build:jupyterlite": "node scripts/build-jupyterlite.mjs",
    "build:embed": "node scripts/build-embed.mjs",
    "seed:digital-twin:boulder": "node scripts/seed-boulder-region.mjs",
    "typecheck": "npm run build",
    "lint": "eslint apps packages workers tests",
    "test": "npm run test:frontend",
    "test:frontend": "node --import tsx --test tests/*.test.ts",
    "test:frontend:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-lines=78 --test-coverage-branches=78 --test-coverage-functions=63 --test-coverage-exclude=\"tests/**\" --test-coverage-exclude=\"e2e/**\" --test-coverage-exclude=\"**/*.config.*\" tests/*.test.ts",
    "test:backend": "python -m pytest backend/geolibre_server/tests",
    "test:backend:coverage": "python -m pytest backend/geolibre_server/tests --cov=geolibre_server --cov-report=term-missing --cov-fail-under=55",
    "test:worker": "npm run typecheck -w geolibre-viewer-worker && npm run typecheck -w geolibre-collab-worker && npm run typecheck -w geolibre-tiles-worker",
    "test:e2e": "playwright test",
    "check:rust": "cargo check --manifest-path apps/geolibre-desktop/src-tauri/Cargo.toml",
    "ci": "npm run check:digital-twin-contract && npm run lint && npm run build && npm run test:frontend:coverage && npm run test:worker && npm run test:backend:coverage && npm run check:rust",
    "tauri": "npm run tauri -w geolibre-desktop",
    "tauri:dev": "npm run tauri dev -w geolibre-desktop",
    "tauri:build": "node scripts/tauri-build.mjs",
    "tauri:build:native-duckdb": "node scripts/tauri-build.mjs --native-duckdb",
    "msix:build": "pwsh -NoProfile -ExecutionPolicy Bypass -File packaging/msix/build-msix.ps1",
    "portable:build": "pwsh -NoProfile -ExecutionPolicy Bypass -File packaging/portable/build-portable.ps1",
    "sync:digital-twin-contract": "node scripts/digital-twin-contract.mjs",
    "check:digital-twin-contract": "node scripts/digital-twin-contract.mjs --check"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.1",
    "typescript-eslint": "^8.64.0"
  },
  "overrides": {
    "sweepline-intersections": "^1.5.0",
    "uuid": "^14.0.0",
    "maplibre-gl": "^6.16.0",
    "@loaders.gl/textures": "^4.5.4",
    "@deck.gl/aggregation-layers": "9.4.1",
    "@deck.gl/core": "9.4.1",
    "@deck.gl/extensions": "9.4.1",
    "@deck.gl/geo-layers": "9.4.1",
    "@deck.gl/layers": "9.4.1",
    "@deck.gl/mesh-layers": "9.4.1",
    "@loaders.gl/3d-tiles": "^4.5.4",
    "@loaders.gl/compression": "^4.5.4",
    "@loaders.gl/core": "^4.5.4",
    "@loaders.gl/crypto": "^4.5.4",
    "@loaders.gl/draco": "^4.5.4",
    "@loaders.gl/geoarrow": "^4.5.4",
    "@loaders.gl/gis": "^4.5.4",
    "@loaders.gl/gltf": "^4.5.4",
    "@loaders.gl/i3s": "^4.5.4",
    "@loaders.gl/images": "^4.5.4",
    "@loaders.gl/las": "^4.5.4",
    "@loaders.gl/loader-utils": "^4.5.4",
    "@loaders.gl/math": "^4.5.4",
    "@loaders.gl/mvt": "^4.5.4",
    "@loaders.gl/schema": "^4.5.4",
    "@loaders.gl/schema-utils": "^4.5.4",
    "@loaders.gl/terrain": "^4.5.4",
    "@loaders.gl/tiles": "^4.5.4",
    "@loaders.gl/wms": "^4.5.4",
    "@loaders.gl/worker-utils": "^4.5.4",
    "@loaders.gl/xml": "^4.5.4",
    "@loaders.gl/zip": "^4.5.4",
    "@deck.gl/maplibre": "9.4.1",
    "@luma.gl/core": "^9.4.2",
    "@luma.gl/engine": "^9.4.2",
    "@luma.gl/shadertools": "^9.4.2",
    "@luma.gl/gltf": "^9.4.2",
    "@luma.gl/webgl": "^9.4.2"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "@google/genai": true,
    "core-js": true,
    "esbuild": true,
    "protobufjs": true,
    "sharp": true,
    "workerd": true
  },
  "trustedDependencies": [
    "@google/genai",
    "core-js",
    "esbuild",
    "protobufjs",
    "sharp",
    "workerd"
  ]
}
